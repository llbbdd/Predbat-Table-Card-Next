{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "esnext",
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "target": "esnext",
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "emitDecoratorMetadata": true,
  },
  "include": [
    "src/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
